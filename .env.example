# Copy to .env and fill in your own key. Never commit .env.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# Both modes support tools. Reasoning is retained internally when enabled.
DEEPSEEK_THINKING=false
DEEPSEEK_MAX_TOKENS=4096
DEEPSEEK_TIMEOUT_SECONDS=60

CHEMISTRY_HOST=127.0.0.1
CHEMISTRY_PORT=8765
CHEMISTRY_MAX_TOOL_ROUNDS=6
CHEMISTRY_RUN_TIMEOUT_SECONDS=900
# Relative paths are resolved against this project directory.
CHEMISTRY_DATABASE_PATH=data/agent.sqlite3

# Token budget includes reserved model output. Input triggers compression at 80%.
CHEMISTRY_CONTEXT_WINDOW_TOKENS=32768
CHEMISTRY_CONTEXT_TRIGGER_RATIO=0.8
# Keep this many completed recent turns plus the entire current task.
CHEMISTRY_CONTEXT_RECENT_TURNS=4
CHEMISTRY_CONTEXT_SUMMARY_TOKENS=1024
CHEMISTRY_CONTEXT_TOOL_RESULT_TOKENS=512
# Run scripts/setup_tokenizer.py once; if absent, conservative UTF-8 byte accounting is used.
CHEMISTRY_TOKENIZER_PATH=data/deepseek-tokenizer.json

# Local standalone mode stays anonymous; the server Compose enables these securely.
CHEMISTRY_AUTH_ENABLED=false
CHEMISTRY_COOKIE_SECURE=false
CHEMISTRY_SESSION_TTL_SECONDS=43200
CHEMISTRY_TRUSTED_PROXY_IPS=127.0.0.1

# Local computation platform (SSH + Slurm; no AiiDA initialization).
CHEMISTRY_AUTOMATION_ENABLED=false
# Optional platform data directory; existing data remains in its original location.
# CHEMISTRY_PLATFORM_PATH=/absolute/path/to/private/platform
# Registered Slurm hosts to retain locally, collected at startup and every 6 hours.
# CHEMISTRY_SLURM_HISTORY_HOSTS=cluster-b
# Optional override. Defaults to slurm-history.sqlite3 under CHEMISTRY_PLATFORM_PATH.
# CHEMISTRY_SLURM_HISTORY_PATH=data/slurm-history.sqlite3
# Optional independent queue monitor, with a dedicated platform_bridge consumer.
# CHEMISTRY_SLURM_BRIDGE_URL=http://127.0.0.1:18766
# CHEMISTRY_SLURM_BRIDGE_CONSUMER=chem-agent
# CHEMISTRY_SLURM_BRIDGE_TOKEN_FILE=/absolute/private/path/to/api-token
# CHEMISTRY_SLURM_BRIDGE_QUEUE_HOSTS={"monitor-queue-id":"platform-host-id"}

# Web search: public Mwmbl by default; optionally use your own JSON-enabled SearXNG instance.
CHEMISTRY_WEB_SEARCH_ENABLED=true
# CHEMISTRY_SEARXNG_URL=http://127.0.0.1:8080
# Optional: comma-separated SSH aliases. Local single-user mode only.
# CHEMISTRY_SSH_HOSTS=cluster-b
