[Unit]
Description=One-shot Codex completion trigger for cluster-a Slurm jobs 1755 and 1756
After=chem-research-plugins.service
Wants=chem-research-plugins.service
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%h/.local/share/chem-research-plugins/current
ExecStart=%h/.local/share/chem-research-plugins/env/bin/python %h/.local/share/chem-research-plugins/current/scripts/start_benchmark_trigger.py
Environment=PYTHONUNBUFFERED=1
UMask=0077
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
